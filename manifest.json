{
  "manifest_version": 3,
  "name": "Kororin",
  "version": "1.0.0",
  "description": "Roll a random GitHub repo. For people new to GitHub.",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://api.github.com/*",
    "https://github.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Kororin",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
